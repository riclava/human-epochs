{
  "name": "human-epochs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/app/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "account:create": "tsx --env-file-if-exists=.env scripts/create-account.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "rm -rf dist/server && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/src/app/server.js",
    "test": "tsx --env-file-if-exists=.env --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.12",
    "eventsource-parser": "4.1.3",
    "fastify": "5.12.8",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
