DATABASE_URL=postgresql://human_epochs:human_epochs_local@127.0.0.1:55432/human_epochs
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# 可选。留空时使用本地学习目标引导；接入在线模型时填写服务端密钥。
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-flash

# 在 Web 保存 API Key 时使用。生成 32 字节随机密钥并编码为 base64。
MODEL_CREDENTIAL_ENCRYPTION_KEY=
# 可选的内部模型地址，按完整 Base URL 填写，多个地址用英文逗号分隔。
# MODEL_ALLOWED_PRIVATE_BASE_URLS=http://127.0.0.1:11434/v1
# 非 DeepSeek 的默认连接可声明输出上限。
# MODEL_MAX_OUTPUT_TOKENS=8192

# 本地演示用。正式部署请设置为受信任的已有账号，多个邮箱用英文逗号分隔。
AGENT_SETTINGS_ADMIN_EMAILS=alice@example.test

# 是否允许在登录页自行注册账号。正式部署时如只供受邀用户使用，保持 false，由管理员创建账号。
REGISTRATION_ENABLED=true
# 反向代理之后部署时，填写转发用户地址的代理层数（单层代理填 1），用于按用户地址限流。
TRUST_PROXY=false
# 启动时自动执行迁移，镜像中默认开启。
MIGRATE_ON_START=false
# 邮件：本地开发默认 log（邮件写进服务端日志，可复制其中的链接）。正式部署用 resend 并填写下面几项，或设为 none 关闭。
MAIL_PROVIDER=log
# MAIL_API_KEY=
# MAIL_FROM=Human Epochs <noreply@example.com>
# 邮件里链接的开头，即用户打开网站的地址。本地开发默认 http://127.0.0.1:5173。
# PUBLIC_BASE_URL=http://127.0.0.1:5173
