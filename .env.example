DATABASE_URL=postgresql://human_epochs:human_epochs_local@127.0.0.1:55432/human_epochs
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# 可选。留空时使用本地学习目标引导；接入在线模型时填写服务端密钥。
STUDY_AGENT_API_KEY=
STUDY_AGENT_BASE_URL=https://api.deepseek.com
STUDY_AGENT_MODEL=deepseek-flash

# 在 Web 保存 API Key 时使用。生成 32 字节随机密钥并编码为 base64。
STUDY_AGENT_SETTINGS_KEY=
# 可选的内部模型地址，按完整 Base URL 填写，多个地址用英文逗号分隔。
# STUDY_AGENT_ALLOWED_PRIVATE_BASE_URLS=http://127.0.0.1:11434/v1
# 非 DeepSeek 的默认连接可声明输出上限。
# STUDY_AGENT_MAX_OUTPUT_TOKENS=8192

# 本地演示用。正式部署请设置为受信任的已有账号，多个邮箱用英文逗号分隔。
STUDY_AGENT_ADMIN_EMAILS=alice@example.test
