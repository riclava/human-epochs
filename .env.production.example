# Copy to .env.production for compose.production.yaml. Never commit the filled file.
NODE_ENV=production
POSTGRES_PASSWORD=
# 32 random bytes in base64, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MODEL_CREDENTIAL_ENCRYPTION_KEY=
# Real accounts that may change the runtime settings, comma separated. Demo addresses are refused.
AGENT_SETTINGS_ADMIN_EMAILS=
# Let visitors register. Keep false for an invite-only site and create accounts with account:create.
REGISTRATION_ENABLED=false
# Proxies in front of the app that report the client address (1 behind a single reverse proxy).
TRUST_PROXY=1
# Optional online model; the key can also be saved later on the runtime settings page.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-flash
